<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claude Code Mobile" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Local profile & API manager" android:textColor="@color/muted" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE PROFILE" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
<TextView android:id="@+id/activeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="No profile selected" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:id="@+id/activeBase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Add an Anthropic-compatible endpoint" android:textColor="@color/muted" android:textSize="13sp"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="PROFILES" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/profileList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
<Button android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button" android:text="+  Add API profile" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp"/>
<Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:text="Test active endpoint" android:textAllCaps="false" android:textColor="@color/text" android:textSize="15sp"/>
<Button android:id="@+id/claudeButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:text="Open Claude in browser" android:textAllCaps="false" android:textColor="@color/text" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="This Android port keeps profile switching and endpoint configuration local on the phone. It does not modify or bypass provider usage limits." android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
</LinearLayout></ScrollView>
